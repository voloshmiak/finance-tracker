{
    "swagger": "2.0",
    "info": {
        "description": "This is the API documentation for the Finance Tracker application",
        "title": "Finance Tracker API",
        "contact": {},
        "version": "0.0.7"
    },
    "basePath": "/api",
    "paths": {
        "/assistant": {
            "get": {
                "description": "Serves the HTML chat interface for the AI finance assistant. Protected by HTTP Basic Auth.",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Assistant"
                ],
                "summary": "Assistant chat UI",
                "responses": {
                    "200": {
                        "description": "HTML page",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/assistant/ask": {
            "post": {
                "description": "Sends a natural-language question about your finances and returns the assistant's answer. Protected by HTTP Basic Auth.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Assistant"
                ],
                "summary": "Ask the assistant",
                "parameters": [
                    {
                        "description": "Question payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.askRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.askResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/assistant/models": {
            "get": {
                "description": "Returns the Gemini models that support generation, plus the default. Protected by HTTP Basic Auth.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Assistant"
                ],
                "summary": "List available models",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.modelsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/cron/reminder": {
            "post": {
                "description": "Triggers a Telegram reminder about card reports not yet uploaded this month. Intended to be called by a scheduled job.",
                "tags": [
                    "Cron"
                ],
                "summary": "Send Reminder",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cauth token\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Reminder sent"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/docs": {
            "get": {
                "description": "Serves the interactive API reference UI",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "System"
                ],
                "summary": "API Documentation",
                "responses": {
                    "200": {
                        "description": "HTML page",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns 200 OK when the service is healthy",
                "tags": [
                    "System"
                ],
                "summary": "Health Check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/webhook": {
            "post": {
                "description": "Receives Telegram bot updates. When a message carries a bank statement document (monobank CSV, Credit Agricole XLSX, or a-bank PDF), the file is downloaded, parsed, deduplicated and stored. Authenticated via the Telegram secret token header.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "Telegram"
                ],
                "summary": "Telegram webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Telegram webhook secret token",
                        "name": "X-Telegram-Bot-Api-Secret-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Telegram update payload",
                        "name": "update",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/telegram.Update"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Update processed"
                    },
                    "401": {
                        "description": "Invalid secret token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "assistant.Model": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "e.g. \"gemini-2.5-flash\"",
                    "type": "string"
                },
                "label": {
                    "description": "human-friendly display name",
                    "type": "string"
                }
            }
        },
        "controller.askRequest": {
            "type": "object",
            "properties": {
                "model": {
                    "description": "optional; empty uses the default model",
                    "type": "string"
                },
                "question": {
                    "type": "string"
                }
            }
        },
        "controller.askResponse": {
            "type": "object",
            "properties": {
                "answer": {
                    "type": "string"
                }
            }
        },
        "controller.modelsResponse": {
            "type": "object",
            "properties": {
                "default": {
                    "type": "string"
                },
                "models": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/assistant.Model"
                    }
                }
            }
        },
        "telegram.Chat": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                }
            }
        },
        "telegram.Document": {
            "type": "object",
            "properties": {
                "file_id": {
                    "type": "string"
                },
                "file_name": {
                    "type": "string"
                },
                "file_size": {
                    "type": "integer"
                }
            }
        },
        "telegram.Message": {
            "type": "object",
            "properties": {
                "caption": {
                    "description": "text sent alongside a file (e.g. card last 4 digits)",
                    "type": "string"
                },
                "chat": {
                    "$ref": "#/definitions/telegram.Chat"
                },
                "document": {
                    "$ref": "#/definitions/telegram.Document"
                },
                "message_id": {
                    "type": "integer"
                }
            }
        },
        "telegram.Update": {
            "type": "object",
            "properties": {
                "message": {
                    "$ref": "#/definitions/telegram.Message"
                },
                "update_id": {
                    "type": "integer"
                }
            }
        }
    }
}